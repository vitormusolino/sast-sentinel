# Copie para .env e ajuste:  cp .env.example .env
POSTGRES_PASSWORD=troque-esta-senha
# chave exigida no endpoint /api/scans/import (usado pelo CI). Vazio = sem autenticação (apenas dev)
API_KEY=
# modelo do Ollama: llama3.2:3b (leve, CPU) | llama3.1:8b | qwen2.5-coder:7b (melhor para código, precisa de mais RAM)
OLLAMA_MODEL=llama3.2:3b
AI_ENABLED_DEFAULT=true
# quantos achados (os mais graves) o LLM revisa por scan; em CPU cada um leva ~30-45 s
AI_MAX_FINDINGS=10
GATE_FAIL_ON=HIGH
